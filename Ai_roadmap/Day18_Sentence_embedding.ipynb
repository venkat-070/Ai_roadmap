    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "import numpy\n",
        "sentences = [\n",
        "    \"The store closes at 9pm\",\n",
        "    \"The items avaliable are store's own brands\",\n",
        "    \"The store has an 50% off on food items\",\n",
        "    \"Our stores offer special discounts for customers with V.I.P subscription\",\n",
        "    \"The student has scored 80% in his first semester\",\n",
        "    \"The principal has offered a special reward for top scoring students\",\n",
        "    \"Our store is having opening for manager position\",\n",
        "    \"We are known for the best quality and best price we offer.\"\n",
        "]\n",
        "Query = \"Im looking for an oppurtunity, does you store have any vacancies?\"\n",
        "chunks_embedding = model.encode(sentences)\n",
        "question_embedding = model.encode(Query)\n",
        "scores = cosine_similarity([question_embedding],chunks_embedding)\n",
        "for idx in numpy.argsort(scores)[0][::-1]:\n",
        "  print(f\"{idx+1}:{scores[0][idx]}\")"
      ],
